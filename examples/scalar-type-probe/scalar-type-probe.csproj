<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TeaQLRuntimeSourceRoot Condition="'$(TeaQLRuntimeSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</TeaQLRuntimeSourceRoot>
    <TeaQLRuntimeVersion Condition="'$(TeaQLRuntimeVersion)' == ''">0.3.1</TeaQLRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="generated/**/*.cs" Exclude="generated/**/bin/**;generated/**/obj/**" />
    <Using Include="TeaQL.Core" />
    <Using Include="TeaQL.DataService" />
    <Using Include="TeaQL.Runtime" />
    <Using Include="TeaQL.Sql" />
    <Using Include="TeaQL.Provider.Sqlite" />
  </ItemGroup>
  <ItemGroup Condition="'$(TeaQLUseLocalPackages)' != 'true'">
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Core/TeaQL.Core.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.DataService/TeaQL.DataService.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Runtime/TeaQL.Runtime.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Sql/TeaQL.Sql.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Provider.Sqlite/TeaQL.Provider.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TeaQLUseLocalPackages)' == 'true'">
    <PackageReference Include="TeaQL.Core" Version="[$(TeaQLRuntimeVersion)]" />
    <PackageReference Include="TeaQL.DataService" Version="[$(TeaQLRuntimeVersion)]" />
    <PackageReference Include="TeaQL.Runtime" Version="[$(TeaQLRuntimeVersion)]" />
    <PackageReference Include="TeaQL.Sql" Version="[$(TeaQLRuntimeVersion)]" />
    <PackageReference Include="TeaQL.Provider.Sqlite" Version="[$(TeaQLRuntimeVersion)]" />
  </ItemGroup>
</Project>
