<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TeaQLRuntimeSourceRoot Condition="'$(TeaQLRuntimeSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</TeaQLRuntimeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="TeaQL.Core" /><Using Include="TeaQL.DataService" />
    <Using Include="TeaQL.Runtime" /><Using Include="TeaQL.Sql" /><Using Include="TeaQL.Provider.Sqlite" />
    <Compile Include="EmptyAggregates.cs" />
    <Compile Include="generated/**/*.cs" Exclude="generated/**/bin/**;generated/**/obj/**" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Core/TeaQL.Core.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.DataService/TeaQL.DataService.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Runtime/TeaQL.Runtime.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Sql/TeaQL.Sql.csproj" />
    <ProjectReference Include="$(TeaQLRuntimeSourceRoot)/src/TeaQL.Provider.Sqlite/TeaQL.Provider.Sqlite.csproj" />
  </ItemGroup>
</Project>
