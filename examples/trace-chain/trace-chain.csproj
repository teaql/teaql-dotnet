<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TeaQLRuntimeSourceRoot Condition="'$(TeaQLRuntimeSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</TeaQLRuntimeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="lib/**" />
    <ProjectReference Include="lib/trace-chain-service-lib.csproj" />
  </ItemGroup>
</Project>
