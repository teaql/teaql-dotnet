<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="Generated/robot-task-board-service-lib.csproj"
                      AdditionalProperties="TeaQLRuntimeSourceRoot=$(TeaQLRuntimeSourceRoot)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TeaQLRuntimeSourceRoot Condition="'$(TeaQLRuntimeSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../..</TeaQLRuntimeSourceRoot>
    <TeaQLRuntimeVersion Condition="'$(TeaQLRuntimeVersion)' == ''">0.3.1</TeaQLRuntimeVersion>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>
